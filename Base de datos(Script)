-- ==========================================
-- BASE DE DATOS:
-- CENSO INEGI 
-- ==========================================

DROP DATABASE IF EXISTS censo_inegi_coahuila;

CREATE DATABASE censo_inegi_coahuila
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE censo_inegi_coahuila;

-- ==========================================
-- TABLA USUARIO
-- ==========================================

CREATE TABLE usuario(
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    usuario VARCHAR(50) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    nombre_completo VARCHAR(150) NOT NULL,
    rol VARCHAR(50) NOT NULL DEFAULT 'Administrador',
    fecha_creacion DATETIME DEFAULT CURRENT_TIMESTAMP,
    estado BOOLEAN DEFAULT TRUE
);

-- ==========================================
-- TABLA ESTADO
-- ==========================================

CREATE TABLE estado(
    id_estado INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL
);

-- ==========================================
-- TABLA MUNICIPIO
-- ==========================================

CREATE TABLE municipio(
    id_municipio INT AUTO_INCREMENT PRIMARY KEY,
    id_estado INT NOT NULL,
    nombre VARCHAR(100) NOT NULL,

    CONSTRAINT fk_municipio_estado
    FOREIGN KEY(id_estado)
    REFERENCES estado(id_estado)
);

-- ==========================================
-- TABLA LOCALIDAD
-- ==========================================

CREATE TABLE localidad(
    id_localidad INT AUTO_INCREMENT PRIMARY KEY,
    id_municipio INT NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    codigo_postal VARCHAR(10),

    CONSTRAINT fk_localidad_municipio
    FOREIGN KEY(id_municipio)
    REFERENCES municipio(id_municipio)
);

-- ==========================================
-- TABLA TIPO VIVIENDA
-- ==========================================

CREATE TABLE tipo_vivienda(
    id_tipo_vivienda INT AUTO_INCREMENT PRIMARY KEY,
    descripcion VARCHAR(100) NOT NULL
);

-- ==========================================
-- TABLA VIVIENDA
-- ==========================================

CREATE TABLE vivienda(
    id_vivienda INT AUTO_INCREMENT PRIMARY KEY,

    id_localidad INT NOT NULL,
    id_tipo_vivienda INT NOT NULL,

    calle VARCHAR(100),
    numero VARCHAR(20),
    colonia VARCHAR(100),
    codigo_postal VARCHAR(10),

    num_habitaciones INT NOT NULL,

    agua BOOLEAN DEFAULT FALSE,
    luz BOOLEAN DEFAULT FALSE,
    drenaje BOOLEAN DEFAULT FALSE,
    internet BOOLEAN DEFAULT FALSE,

    fecha_registro DATE,

    CONSTRAINT fk_vivienda_localidad
    FOREIGN KEY(id_localidad)
    REFERENCES localidad(id_localidad),

    CONSTRAINT fk_vivienda_tipo
    FOREIGN KEY(id_tipo_vivienda)
    REFERENCES tipo_vivienda(id_tipo_vivienda)
);

-- ==========================================
-- TABLA HABITANTE
-- ==========================================

CREATE TABLE habitante(
    id_habitante INT AUTO_INCREMENT PRIMARY KEY,

    id_vivienda INT NOT NULL,

    nombre VARCHAR(100) NOT NULL,
    apellido_paterno VARCHAR(100) NOT NULL,
    apellido_materno VARCHAR(100),

    sexo ENUM('M','F') NOT NULL,

    edad INT,

    fecha_nacimiento DATE,

    estado_civil VARCHAR(50),

    escolaridad VARCHAR(100),

    ocupacion VARCHAR(100),

    ingresos DECIMAL(10,2),

    CONSTRAINT fk_habitante_vivienda
    FOREIGN KEY(id_vivienda)
    REFERENCES vivienda(id_vivienda)
);

-- ==========================================
-- TABLA ACTIVIDAD ECONOMICA
-- ==========================================

CREATE TABLE actividad_economica(
    id_actividad INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    descripcion VARCHAR(255)
);

-- ==========================================
-- TABLA VIVIENDA ACTIVIDAD
-- ==========================================

CREATE TABLE vivienda_actividad(
    id_vivienda_actividad INT AUTO_INCREMENT PRIMARY KEY,

    id_vivienda INT NOT NULL,
    id_actividad INT NOT NULL,

    CONSTRAINT fk_va_vivienda
    FOREIGN KEY(id_vivienda)
    REFERENCES vivienda(id_vivienda),

    CONSTRAINT fk_va_actividad
    FOREIGN KEY(id_actividad)
    REFERENCES actividad_economica(id_actividad)
);

